# Shared homelab PostgreSQL operator environment.
# Copy to .env, chmod 600, and replace every change-me value.

POSTGRES_ADMIN_USER=homelab_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin-password
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_PORT=5432

# Dedicated Movie Watcher role and database. Use the same three values in
# deploy/torwatch-server/.env. The role owns only this database.
MOVIE_WATCHER_POSTGRES_USER=torwatch
MOVIE_WATCHER_POSTGRES_PASSWORD=change-me-movie-watcher-password
MOVIE_WATCHER_POSTGRES_DB=torwatch

TZ=Asia/Kolkata
