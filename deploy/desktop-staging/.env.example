# torWatch Windows desktop staging - operator environment (repair-pass hygiene:
# secrets come only from this gitignored file; .env.example is the tracked,
# redacted template). Copy to `.env` and fill in.

# --- required ---
# Throwaway password for the STAGING PostgreSQL only. Never reuse a real
# database password. This database is isolated in the `torwatch-staging`
# Compose project and is not the development, homeserver, or production DB.
STAGING_PG_PASSWORD=change-me-staging-password

# --- optional (defaults shown) ---
# Host ports for the staging stack (always bound to 127.0.0.1).
STAGING_PG_PORT=5433
BACKEND_PORT=4001
FRONTEND_PORT=4174

# Torrent data root (backend writes downloaded pieces here). Use a SHORT
# path on Windows: deep paths trigger the anacrolix \\?\ long-path bug
# (FlushFileBuffers fails on extended-length handles).
TORRENT_DATA_ROOT=
# Torrnent client listen port override (tests use 0 = random).
# TORRENT_LISTEN_PORT=

# Live provider credential (backend-only, never in the browser bundle).
# Leave EMPTY to run with a provider-degraded catalog; automated validation
# then uses a deterministic local provider stub, clearly labelled as
# stub-backed evidence.
TMDB_API_KEY=

# OpenSubtitles credential (backend-only). Without it the player's subtitle
# sheet reports "OpenSubtitles API key is not configured". Get one at
# https://www.opensubtitles.com/en/api-keys
OPENSUB_API_KEY=

# Automatic video transcoding policy: "auto" (default) converts sources the
# device cannot direct-play; "off" refuses them (Radxa/homeserver CPU
# policy). ffprobe inspection and the stream-copy remux fallback stay active.
PLAYBACK_TRANSCODE_MODE=auto

# Optional WireGuard/vpn details are NOT part of staging.

# --- Prowlarr (-WithProwlarr; optional) ---
# By default the harness reads the repository Prowlarr instance's key from
# data\prowlarr\config.xml. To use YOUR OWN Docker Prowlarr instead, set both
# values (URL it is reachable at, and its key from Prowlarr Settings >
# General > API Key). Values are used in-memory and never echoed.
#PROWLARR_URL=http://127.0.0.1:9696
#PROWLARR_API_KEY=

# --- Tailscale (optional; omit entirely for -NoTailscale local staging) ---
# HTTPS ports the tailnet will use for the frontend and backend Serve
# mappings. Both are created only when Tailscale is installed, running, and
# logged in; Funnel is never used.
TAILNET_FRONTEND_SERVE_PORT=443
TAILNET_BACKEND_SERVE_PORT=8443
# Optional explicit https origin of this node on the tailnet (e.g.
# https://staging-box.tailnet-name.ts.net). When empty, the harness derives it
# from `tailscale status --json` (MagicDNS name) and prints it REDACTED in
# evidence.
#TAILNET_ORIGIN=

# --- Playback compatibility service (M1.3.x; optional) ---
# Absolute or PATH-resolvable tool locations. Both must verify BEFORE the
# backend advertises playback.compat.v1; without them the capability stays
# absent and the /v2/playback/* routes do not exist.
FFMPEG_PATH=
FFPROBE_PATH=
# Playback session data root (default: <TORRENT_DATA_ROOT>/playback-sessions).
# PLAYBACK_DATA_ROOT=
# PLAYBACK_MAX_TRANSCODES=1
# PLAYBACK_SESSION_TTL=2h
# PLAYBACK_PROBE_TIMEOUT=20s
# PLAYBACK_MAX_TRANSCODE_HEIGHT=1080
# VALIDATION ONLY: when set, sessions resolve media from this directory
# (deterministic evidence without torrent peers). Leave EMPTY in production.
# TORWATCH_PLAYBACK_FIXTURE_ROOT=
