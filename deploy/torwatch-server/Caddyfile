# Gateway entrypoint (FR-008): the ONLY client-facing surface.
# /stream (media byte-ranges) and /buffer/info (SSE) must never be buffered
# or compressed (plan P7 performance goal; T061 verification).
#
# No `encode` directive: API JSON is small, and global compression risks
# buffering/transforming media responses.

(app) {
	# SSE: flush every event immediately, disable buffering entirely.
	@sse path /buffer/info
	reverse_proxy @sse vod:4001 {
		flush_interval -1
	}

	# Media streaming: pass byte-ranges through untouched, flush aggressively.
	@media path /stream
	reverse_proxy @media vod:4001 {
		flush_interval -1
	}

	reverse_proxy vod:4001
}

# The published port (LAN and tailnet). Who sent a request cannot be told
# here, so anything claiming a Tailscale identity is dropped.
:8080 {
	request_header -Tailscale-User-Login
	request_header -Tailscale-User-Name
	request_header -Tailscale-User-Profile-Pic
	request_header -X-Torwatch-Identity-Proof
	import app
}

# Tailscale Serve's port (published on 127.0.0.1 only): Serve names the
# tailnet user of each request (Tailscale-User-Login) and the proof tells the
# server it came this way (internal/profiles: who may manage profiles).
:8081 {
	request_header X-Torwatch-Identity-Proof {$TORWATCH_IDENTITY_SECRET}
	import app
}
