# torWatch homeserver package — operator environment (constitution VI).
# Copy to `.env` and fill in; `.env` is gitignored and NEVER committed,
# logged, or baked into images. All values come from the operator only.
# preflight.sh rejects unchanged placeholders and world-readable .env files.

# --- required ---
# Absolute path of the persistent data tree (architecture §6). Created with
# documented ownership by the runbook; preflight validates writability.
# Fedora SELinux note: see SELINUX_MOUNT_OPTS below.
TORWATCH_DATA_DIR=/srv/torwatch-data

# Pin an IMMUTABLE image tag for the deployment (never :latest). Build it on
# any machine with scripts/build-images.sh <version>, or load the release
# image tarball (docker load) on the homeserver.
TORWATCH_IMAGE=torwatch-server:2.0.0-rc.1
TORWATCH_VERSION=2.0.0-rc.1

POSTGRES_USER=torwatch
POSTGRES_PASSWORD=change-me-operator-generated
POSTGRES_DB=torwatch

# Database ownership mode:
# - bundled: this Compose project starts its own PostgreSQL service.
# - shared: connect to deploy/homelab-postgres over the private homelab-db
#   network. POSTGRES_PASSWORD must match MOVIE_WATCHER_POSTGRES_PASSWORD in
#   that stack's .env.
TORWATCH_DB_MODE=bundled
POSTGRES_HOST=homelab-postgres
POSTGRES_CONTAINER=homelab-postgres

# --- gateway / admin ---
# The only LAN-published port (Caddy gateway, FR-008).
GATEWAY_PORT=8080
# Loopback-only Prowlarr admin port. Reach it from a workstation:
#   ssh -L 9696:127.0.0.1:9696 <user>@<torwatch-host>
PROWLARR_ADMIN_PORT=9696
# Loopback-only FlareSolverr port (VPN mode only; direct mode publishes
# nothing for FlareSolverr).
FLARESOLVERR_PORT=8191

# --- Prowlarr ---
# Leave EMPTY for first installs: the package-owned bootstrap reads the key
# Prowlarr generates and installs the starter indexers on an empty instance
# (internal/bootstrap). Supply a key only to pin an existing instance.
PROWLARR_API_KEY=

# --- optional credentials (backend-only) ---
# OpenSubtitles: https://www.opensubtitles.com/en/api-keys
OPENSUB_API_KEY=
# TMDb: https://www.themoviedb.org/settings/api — without it the catalog is
# provider-degraded (no search/detail/recommendations).
TMDB_API_KEY=

# --- optional tuning (defaults shown) ---
PUID=1000
PGID=1000
TZ=UTC
PLAYBACK_TRANSCODE_MODE=off
FLARESOLVERR_LOG_LEVEL=info

# Browser/mobile client origins allowed to call the versioned read-only
# surfaces (/v1/version, /readyz, /v2/catalog/*) cross-origin. Explicit
# allowlist ONLY — a "*" entry is ignored with a boot warning. The default
# (unset) covers the Electron renderer (file:// sends `Origin: null`) and
# the npm run dev server. Add your phone/wrapper origins here when they
# exist (e.g. http://192.168.1.50:5173); separate multiple origins with
# commas.
# Native mobile shells use the two exact Capacitor origins below.
#TORWATCH_ALLOWED_CLIENT_ORIGINS=null,http://localhost:5173,capacitor://localhost,https://localhost

# --- Fedora SELinux ---
# On SELinux-enforcing hosts (Fedora default), bind mounts must be labeled
# for container access. Set:
#   SELINUX_MOUNT_OPTS=,z
# Leave it UNSET (commented) on Windows Docker Desktop, WSL2, and
# SELinux-disabled/permissive hosts. See docs/v2-server-package/fedora-runbook.md.
#SELINUX_MOUNT_OPTS=,z

# --- embedded-VPN mode (compose.vpn.yaml overlay ONLY) ---
# Everything below is ignored in direct mode. Generate a WireGuard key with
# your provider (e.g. https://my.mullvad.net/en/wireguard-config).
#
# How to choose a mode (scripts honor this too):
#   - Direct mode (default): run compose WITHOUT the vpn overlay and leave
#     TORWATCH_MODE unset or "direct". Gluetun never starts; WireGuard
#     credentials in this file are simply unused. All services (prowlarr,
#     flaresolverr, vod, postgres, caddy) run on the normal network route.
#   - Embedded-VPN mode: set TORWATCH_MODE=embedded-vpn here AND always pass
#     both files: -f compose.yaml -f compose.vpn.yaml. Gluetun starts and
#     requires WIREGUARD_PRIVATE_KEY below (it fails fast without one).
#     backup/restore/update/verify read TORWATCH_MODE to include the overlay.
#TORWATCH_MODE=direct
#VPN_SERVICE_PROVIDER=mullvad
#VPN_TYPE=wireguard
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_ADDRESSES=
#VPN_SERVER_COUNTRIES=
#VPN_SERVER_CITIES=

# Torrent source cache: 20 GiB budget, evict idle sources after 24 hours.
# Prepared offline packages retain their independent 48-hour renewable expiry.
# 0 explicitly disables the corresponding cache limit.
CACHE_MAX_BYTES=21474836480
CACHE_EVICT_TTL=24h
# 0 uses free category ports. A positive value reserves four consecutive ports
# (movie=base, tv=base+1, anime=base+2, misc=base+3); maximum base is 65532.
TORRENT_LISTEN_PORT=0

# Check real Go stream/SSE endpoints through the gateway with a generated
# 1 MiB torrent and an internal-only HTTP source. Requires Python 3 on host.
# Verification generates the source under $TORWATCH_DATA_DIR/verification.
TORWATCH_VERIFY_FIXTURES=0
# Fixture mode derives both URLs automatically. For an existing real source,
# set full quoted URLs with magnet/infoHash + fileIndex; SSE needs sse=1.
#TORWATCH_VERIFY_STREAM_URL='http://127.0.0.1:8080/stream?...'
#TORWATCH_VERIFY_SSE_URL='http://127.0.0.1:8080/buffer/info?...&sse=1'
