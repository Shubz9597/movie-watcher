# torWatch homeserver package — operator environment (constitution VI).
# Copy to `.env` and fill in; `.env` is gitignored and NEVER committed,
# logged, or baked into images. All values come from the operator only.

# --- required ---
# Pin an IMMUTABLE image tag for the deployment (never :latest).
TORWATCH_IMAGE=torwatch-server:1.0.0
TORWATCH_VERSION=1.0.0
POSTGRES_USER=torwatch
POSTGRES_PASSWORD=change-me-operator-generated
POSTGRES_DB=torwatch
# Prowlarr API key (set after first prowlarr bootstrap, or pre-seeded by
# the package-owned bootstrap step in the runbook).
PROWLARR_API_KEY=change-me-prowlarr-api-key

# --- VPN (Gluetun + Mullvad WireGuard) ---
# Prowlarr and FlareSolverr route through the Gluetun VPN tunnel so
# indexers behind ISP blocks (Nyaa.si etc.) are reachable. Generate a
# WireGuard key at https://my.mullvad.net/en/wireguard-config — each
# Mullvad account gets 5 slots; create one per deployment.
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRIES=Switzerland

# --- OpenSubtitles (backend-only credential for subtitle search) ---
# Get a key at https://www.opensubtitles.com/en/api-keys
OPENSUB_API_KEY=

# --- optional (defaults shown) ---
GATEWAY_PORT=8080
PROWLARR_PORT=9696
FLARESOLVERR_PORT=8191
PUID=1000
PGID=1000
TZ=UTC
# Admission envelope (SC-006): conservative default of ONE guaranteed
# distinct title on the 4 GB reference host; raise only with measured
# headroom (T063).
WATCH_MAX_ACTIVE_TITLES=1

# Browser/mobile client origins allowed to call the versioned read-only
# surfaces (/v1/version, /readyz, /v2/catalog/*) cross-origin. Explicit
# allowlist ONLY — a "*" entry is ignored with a boot warning. The default
# (unset) covers the Electron renderer (file:// sends `Origin: null`) and
# the npm run dev server. Add your phone/wrapper origins here when they
# exist (e.g. http://192.168.1.50:5173); separate multiple origins with
# commas.
#TORWATCH_ALLOWED_CLIENT_ORIGINS=null,http://localhost:5173
