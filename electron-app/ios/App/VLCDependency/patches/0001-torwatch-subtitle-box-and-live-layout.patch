 //#define DEBUG_REGION
 
+/* TorWatch: a track of plain dialogue ("English Dubtitles", "Full
+ * Subtitles", "SDH") is drawn like plain-text subtitles: one translucent
+ * box behind each subtitle, in the player's font. Signs, songs and typeset
+ * tracks keep the styling their authors gave them. Whole words only, so
+ * "Subtitles" and "Dubtitles" are not "titles". */
+static bool TitleHasWord( const char *psz_title, const char *const *ppsz_words )
+{
+    const char *p = psz_title;
+    while( *p )
+    {
+        while( *p && !isalnum( (unsigned char)*p ) )
+            p++;
+        const char *psz_start = p;
+        while( *p && isalnum( (unsigned char)*p ) )
+            p++;
+        size_t i_len = p - psz_start;
+        for( size_t i = 0; i_len > 0 && ppsz_words[i]; i++ )
+            if( strlen( ppsz_words[i] ) == i_len && !strncasecmp( psz_start, ppsz_words[i], i_len ) )
+                return true;
+    }
+    return false;
+}
+
+static bool IsDialogueTrack( const char *psz_title )
+{
+    static const char *const styled[] = { "sign", "signs", "song", "songs", "stylized", "styled",
+                                          "karaoke", "titles", "typeset", "forced", NULL };
+    static const char *const plain[] = { "dub", "dubs", "dubbed", "dubtitles", "dialogue", "dialog",
+                                         "full", "cc", "sdh", NULL };
+    return psz_title && !TitleHasWord( psz_title, styled ) && TitleHasWord( psz_title, plain );
+}
+
+static void SetDialogueBox( decoder_t *p_dec, ASS_Renderer *p_renderer )
+{
+    ASS_Style style;
+    memset( &style, 0, sizeof(style) );
+    char *psz_font = var_InheritString( p_dec, "freetype-font" );
+#if defined( __APPLE__ )
+    style.FontName = psz_font && *psz_font ? psz_font : (char *)"Menlo";
+#else
+    style.FontName = psz_font && *psz_font ? psz_font : (char *)"monospace";
+#endif
+    /* Sizes are for a 288-line script; libass rescales them */
+    style.FontSize        = 18;
+    style.PrimaryColour   = 0xFFFFFF00; /* RRGGBBAA, AA = transparency */
+    style.SecondaryColour = 0xFFFFFF00;
+    style.OutlineColour   = 0x00000066;
+    style.BackColour      = 0x00000066; /* black, 60% opaque */
+    style.BorderStyle     = 4;          /* one box behind the whole subtitle */
+    style.Outline         = 0;
+    style.Shadow          = 3;          /* the box's padding */
+    style.ScaleX = style.ScaleY = 1.0;
+    ass_set_selective_style_override( p_renderer, &style ); /* copies strings */
+    ass_set_selective_style_override_enabled( p_renderer,
+        ASS_OVERRIDE_BIT_STYLE | ASS_OVERRIDE_BIT_SELECTIVE_FONT_SCALE );
+    free( psz_font );
+    msg_Dbg( p_dec, "dialogue track: drawn in the subtitle box" );
+}
