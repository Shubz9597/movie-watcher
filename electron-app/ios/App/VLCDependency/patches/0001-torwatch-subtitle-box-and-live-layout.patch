+static atomic_int layout_margin_permille = ATOMIC_VAR_INIT(-1);
+static atomic_int layout_text_scale = ATOMIC_VAR_INIT(0);
+
+void spu_SetLayout(int margin_permille, int text_scale)
+{
+    atomic_store(&layout_margin_permille, margin_permille > 1000 ? 1000 : margin_permille);
+    atomic_store(&layout_text_scale, text_scale > 500 ? 500 : text_scale);
+}
+
+void spu_GetLayout(int *margin_permille, int *text_scale)
+{
+    if (margin_permille)
+        *margin_permille = atomic_load(&layout_margin_permille);
+    if (text_scale)
+        *text_scale = atomic_load(&layout_text_scale);
+}
